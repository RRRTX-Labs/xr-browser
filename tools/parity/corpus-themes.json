{
  "schema_version": 1,
  "pair": "themes",
  "protocol": "themes/host_protocol.md",
  "provenance": "P9-T0-a. Every method in themes/host_protocol.md has >=1 case (parity-completeness law). The import/validate-doc refusal families mirror the C++ loader taxonomy one-for-one (unknown token, type mismatch, duplicate key, oversize, reserved-token remap, url()/font reference, >=3 contrast-fail palettes, one passing palette) and are byte-compared — the T0-a canonicalization made the refusal detail strings byte-identical across backends, and this corpus is the regression lock. theme_doc cases expand from ui/themes/tokens.json built-in palettes (deterministic).",
  "cases": [
    {"id": "flag_status", "method": "flag-status", "args": {}, "expect": "ok"},
    {"id": "list_fresh", "method": "list", "args": {}, "expect": "ok"},
    {"id": "current_fresh", "method": "current", "args": {}, "expect": "ok"},
    {"id": "apply_dark", "method": "apply", "args": {"name": "dark"}, "expect": "ok"},
    {"id": "apply_system", "method": "apply", "args": {"name": "system"}, "expect": "ok"},
    {"id": "system_mode_high_contrast", "method": "system-mode", "args": {"mode": "high-contrast"}, "expect": "ok"},

    {"id": "import_passing_palette", "method": "import",
     "theme_doc": {"base": "high-contrast"}, "expect": "ok"},
    {"id": "validate_doc_full_dark", "method": "validate-doc",
     "theme_doc": {"base": "dark"}, "expect": "ok"},

    {"id": "import_unknown_token", "method": "import",
     "args": {"theme-doc": "{\"ghost\":\"#ffffff\"}"}, "expect": "reject"},
    {"id": "import_type_mismatch", "method": "import",
     "args": {"theme-doc": "{\"text\":12345,\"radius\":\"#ffffff\"}"}, "expect": "reject"},
    {"id": "import_duplicate_key", "method": "import",
     "args": {"theme-doc": "{\"text\":\"#111111\",\"text\":\"#222222\"}"}, "expect": "reject"},
    {"id": "import_oversize", "method": "import",
     "args": {}, "pad_bytes": 70000, "expect": "reject"},
    {"id": "import_reserved_remap", "method": "import",
     "args": {"theme-doc": "{\"critical-red\":\"#00aa00\",\"surface\":\"#ffffff\"}"}, "expect": "reject"},
    {"id": "import_font_url", "method": "import",
     "args": {"theme-doc": "{\"font-family-ui\":\"url(https://x.example/f.woff2)\"}"}, "expect": "reject"},
    {"id": "import_font_remote", "method": "import",
     "args": {"theme-doc": "{\"font-family-ui\":\"https://fonts.example/x\"}"}, "expect": "reject"},
    {"id": "import_contrast_fail_light", "method": "import",
     "theme_doc": {"base": "light"}, "expect": "reject"},
    {"id": "import_contrast_fail_destructive", "method": "import",
     "theme_doc": {"base": "light",
                   "overrides": {"danger-destructive": "#ff9d9d"}}, "expect": "reject"},
    {"id": "import_contrast_fail_trust", "method": "import",
     "theme_doc": {"base": "light",
                   "overrides": {"trust-standard": "#4caf50"}}, "expect": "reject"},
    {"id": "validate_doc_garbage", "method": "validate-doc",
     "args": {"theme-doc": "not-json"}, "expect": "reject",
     "compare": "code"}
  ]
}
