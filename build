#!/usr/bin/env bash
# build — the XR build entrypoint (Plan P2 Objective: `./build x`).
#
# Dispatches to the stdlib-first Python tools under buildsys/. Subcommands:
#   sync gen compile preflight patch sbom sbom-gate brand-check version sign
#   budget test refresh help
#
# Mock mode: `./build --mock <sub> …` is allowed ONLY when XR_ALLOW_MOCK=1 is
# set; every line then carries "MOCK MODE — not a build". Mock tests the
# pipeline plumbing, never acts as build evidence.
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
export PYTHONPATH="$HERE/buildsys${PYTHONPATH:+:$PYTHONPATH}"
PY="${PYTHON:-python3}"

usage() {
  sed -n '2,9p' "$0"
  echo
  echo "subcommands:"
  echo "  sync       create/verify the pinned checkout (+ xr-core mount at src/xr)"
  echo "  refresh    create a pin-refresh branch (never pushes)"
  echo "  preflight  refuse under-provisioned hosts; record nproc/RAM/disk"
  echo "  gen        resolve argsets + run gn gen"
  echo "  compile    run ninja on a target (default //xr:xr_all)"
  echo "  patch      apply|verify|revert|lint the patch manifest"
  echo "  sbom       emit a CycloneDX 1.6 SBOM"
  echo "  sbom-gate  validate an SBOM against the vendored schema"
  echo "  brand-check  verify de-branding (binary) or endpoint-deny scan"
  echo "  version    build the version string"
  echo "  sign       TEST-ONLY signing scaffold"
  echo "  budget     patch-budget meter (report-only this phase)"
  echo "  test       run the pytest suites (tools/tests + buildsys/*/tests)"
}

case "${1:-}" in
  --mock)
    if [[ "${XR_ALLOW_MOCK:-}" != "1" ]]; then
      echo "error: --mock requires XR_ALLOW_MOCK=1 in the environment (Plan P2)." >&2
      exit 2
    fi
    export XR_ALLOW_MOCK=1
    shift
    ;;
  ""|-h|--help|help) usage; exit 0 ;;
esac

sub="$1"; shift || true
case "$sub" in
  sync)       exec "$PY" "$HERE/buildsys/sync.py" sync "$@" ;;
  refresh)    exec "$PY" "$HERE/buildsys/sync.py" refresh "$@" ;;
  preflight)  exec "$PY" "$HERE/buildsys/preflight.py" "$@" ;;
  gen)        exec "$PY" "$HERE/buildsys/gn/gen.py" "$@" ;;
  compile)    exec "$PY" "$HERE/buildsys/gn/compile.py" "$@" ;;
  patch)      exec "$PY" "$HERE/buildsys/patching/apply.py" "$@" ;;
  sbom)       exec "$PY" "$HERE/buildsys/sbom/emit_sbom.py" "$@" ;;
  sbom-gate)  exec "$PY" "$HERE/buildsys/sbom/sbom_gate.py" "$@" ;;
  brand-check) exec "$PY" "$HERE/buildsys/branding/brand_check.py" "$@" ;;
  version)    exec "$PY" "$HERE/buildsys/branding/gen_version.py" "$@" ;;
  sign)       exec "$PY" "$HERE/buildsys/signing/sign_artifact.py" "$@" ;;
  budget)     exec "$PY" "$HERE/buildsys/farm/budget_meter.py" "$@" ;;
  test)       exec "$PY" -m pytest tools/tests buildsys -q ;;
  *)
    echo "error: unknown subcommand '$sub'" >&2
    usage
    exit 2
    ;;
esac
